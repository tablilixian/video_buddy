      "styleRole": "cardBody",
      "example": "自转轴与公转面成 23.4 度角",
      "onOverflow": "reject"
    },
    {
      "id": "card2",
      "label": "要点 2 关键词",
      "type": "string",
      "required": true,
      "maxChars": 8,
      "maxLines": 1,
