{
  "slots": [
    {
      "id": "title",
      "label": "主标题",
      "type": "string",
      "required": true,
      "maxChars": 10,
      "maxLines": 1,
      "maxCharsPerLine": 10,
      "semantic": "四到十个汉字，直接给出结论或悬念，不要写「关于……的科普」",
      "styleRole": "title",
      "example": "四季从哪来",
      "onOverflow": "reject"
    },
    {
      "id": "lead",
      "label": "开场结论",
      "type": "string",
      "required": true,
      "maxChars": 24,
      "maxLines": 1,
      "maxCharsPerLine": 24,
      "semantic": "一句话把结论说完（观众看完这一句就该知道答案）；可用逗号，不要换行",
      "styleRole": "body",
      "example": "不是离太阳远近，而是地轴斜了 23.4°",
      "onOverflow": "reject"
    },
    {
      "id": "card1",
      "label": "要点 1 关键词",
      "type": "string",
      "required": true,
      "maxChars": 8,
      "maxLines": 1,
      "maxCharsPerLine": 8,
      "semantic": "第一个要点的短词（名词或动宾短语），不超过八字",
      "styleRole": "cardTitle",
      "example": "地轴倾斜",
      "onOverflow": "reject"
    },
    {
      "id": "card1Body",
      "label": "要点 1 解释",
      "type": "string",
