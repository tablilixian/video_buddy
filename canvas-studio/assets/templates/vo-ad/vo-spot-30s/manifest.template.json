{
  "id": "tpl-vo-ad-vo-spot",
  "meta": {
    "title": "{{productName}}",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "durationInFrames": 420,
    "backgroundColor": "#07070f",
    "look": {
      "contrast": 1.05,
      "vignette": 0.3,
      "grain": 0.02
    }
  },
  "tracks": [
    {
      "id": "vo-full",
      "type": "video",
      "src": "{{voVideo}}",
